{
  "expo": {
    "name": "DeyNotes",
    "slug": "deynotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deynotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.debiyan.deynotes",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.debiyan.deynotes",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "project": {
        "brandName": "Debiyan",
        "appName": "DeyNotes",
        "appKey": "deynotes",
        "databaseName": "deynotes.db",
        "primaryColor": "#2563EB",
        "backgroundColor": "#F8FAFC",
        "apkPrefix": "deynotes",
        "releaseOwner": "",
        "releaseRepository": "deynotes"
      },
      "eas": {
        "projectId": "05b7389e-706f-407f-bb19-f89b30a5e86d"
      }
    },
    "owner": "robbirodhiyan"
  }
}
